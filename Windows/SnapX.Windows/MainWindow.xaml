<Window
    x:Class="SnapX.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SnapX">
    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="SnapX" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Windows preview" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="FramedCaptureButton" Grid.Column="0" Click="FramedCaptureButton_Click" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE722;" />
                    <TextBlock Text="框选截图" />
                </StackPanel>
            </Button>

            <Button x:Name="FullScreenCaptureButton" Grid.Column="1" Click="FullScreenCaptureButton_Click" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7F4;" />
                    <TextBlock Text="全屏截图" />
                </StackPanel>
            </Button>

            <Button x:Name="HistoryButton" Grid.Column="2" Click="HistoryButton_Click" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE81C;" />
                    <TextBlock Text="历史" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="14">
            <ToggleSwitch x:Name="LaunchAtLoginSwitch" Header="开机启动" Toggled="LaunchAtLoginSwitch_Toggled" />
            <Slider x:Name="OpacitySlider" Header="钉图透明度" Minimum="25" Maximum="100" Value="100" />
            <ToggleSwitch x:Name="MousePassthroughSwitch" Header="允许钉图鼠标穿透" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <CommandBar Grid.Row="3" HorizontalAlignment="Stretch" DefaultLabelPosition="Right">
            <AppBarButton Icon="Setting" Label="设置" Click="SettingsButton_Click" />
            <AppBarButton Icon="Refresh" Label="重启" Click="RestartButton_Click" />
            <AppBarButton Icon="Cancel" Label="退出" Click="ExitButton_Click" />
        </CommandBar>
    </Grid>
</Window>
